# ===================================================
# CodeMentor AI - Backend Environment Variables
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (Primary: MongoDB)
# Local MongoDB: mongodb://127.0.0.1:27017/codementor
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codementor?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codementor

# Local AI (Ollama) Provider Configuration
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:7b

# JWT Authentication Configuration
JWT_SECRET=your_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
